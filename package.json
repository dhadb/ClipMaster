{
  "name": "clipmaster",
  "version": "5.0.0",
  "description": "Local-first Windows clipboard knowledge manager with secure search, quick paste, privacy controls, and image history.",
  "author": "ClipMaster Team",
  "license": "MIT",
  "keywords": [
    "clipboard-manager",
    "windows",
    "electron",
    "react",
    "typescript",
    "productivity",
    "privacy",
    "local-first",
    "clipboard-history"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhadb/ClipMaster.git"
  },
  "bugs": {
    "url": "https://github.com/dhadb/ClipMaster/issues"
  },
  "homepage": "https://github.com/dhadb/ClipMaster#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build && electron-builder --publish=never",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src electron",
    "check": "npm run typecheck && vitest run && vite build",
    "check:build": "npm run typecheck && vite build",
    "build:release": "npm run typecheck && vite build && electron-builder --publish=never -c.forceCodeSigning=true"
  },
  "build": {
    "appId": "com.clipmaster.app",
    "productName": "ClipMaster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/icon.ico",
      "public/icon.png",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ClipMaster",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": false,
      "license": null
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.73.0",
    "pinyin-pro": "^3.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "safe-regex2": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.16",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.31",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "4.1.4",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  }
}
